APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./orchestrator.db
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEFAULT_PROVIDER=mock
LOG_LEVEL=INFO
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
AUTH_REQUIRED=true
SESSION_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
EXPENSIVE_RATE_LIMIT_PER_MINUTE=12
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_MINUTES=1440
# Comma-separated owner emails. These users see the Admin item in the app.
ADMIN_EMAILS=
# Optional: sentry.io DSN for backend error tracking. Never expose this as a secret.
SENTRY_DSN=
# Optional browser Sentry project DSN. It is public by design, but use a
# separate frontend project from the backend one.
VITE_SENTRY_DSN=
PUBLIC_URL=http://127.0.0.1:8000
# User registration and sign-in with a Google account.
# Register: ${PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_CALLBACK_URL=
GOOGLE_AUTH_STATE_TTL_SECONDS=600
# X / Twitter OAuth 2.0 Authorization Code with PKCE.
# Register this exact callback in the X Developer Portal:
# ${PUBLIC_URL}/api/v1/integrations/twitter/oauth/callback
TWITTER_OAUTH_CLIENT_ID=
# Required only for confidential OAuth clients. Leave empty for a public PKCE client.
TWITTER_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_CALLBACK_URL=
TWITTER_OAUTH_SCOPES=tweet.read users.read offline.access
TWITTER_OAUTH_STATE_TTL_SECONDS=600
# Gemini model access through a Google account. Create a Web application OAuth
# client in Google Auth Platform and register this exact redirect URI:
# ${PUBLIC_URL}/api/v1/integrations/google-model/oauth/callback
GOOGLE_MODEL_OAUTH_CLIENT_ID=
GOOGLE_MODEL_OAUTH_CLIENT_SECRET=
GOOGLE_MODEL_OAUTH_CALLBACK_URL=
GOOGLE_MODEL_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/cloud-platform https://www.googleapis.com/auth/generative-language.retriever
GOOGLE_MODEL_OAUTH_STATE_TTL_SECONDS=600
# Knowledge connectors. Register the shared callback below for Notion and Slack;
# Google Drive and YouTube share the Google Context OAuth client.
CONTEXT_OAUTH_STATE_TTL_SECONDS=600
# GitHub account connector. Register an OAuth web app and use:
# ${PUBLIC_URL}/api/v1/integrations/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_SCOPES=read:user repo
GITHUB_OAUTH_STATE_TTL_SECONDS=600
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CALLBACK_URL=
# Paste the verification token issued when the global Notion webhook subscription is created.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CALLBACK_URL=
SLACK_OAUTH_SCOPES=channels:read,groups:read,channels:history,groups:history,users:read,files:read
SLACK_SIGNING_SECRET=
GOOGLE_CONTEXT_OAUTH_CLIENT_ID=
GOOGLE_CONTEXT_OAUTH_CLIENT_SECRET=
GOOGLE_CONTEXT_OAUTH_CALLBACK_URL=
GOOGLE_DRIVE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/drive.readonly
YOUTUBE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/youtube.readonly
CONTEXT_SYNC_INTERVAL_SECONDS=900
# Optional platform-owned Deep Research credentials. Users never enter these.
# Without them Orbit automatically uses public web search and site-scoped results.
RESEARCH_BRAVE_API_KEY=
RESEARCH_YOUTUBE_API_KEY=
RESEARCH_TIKTOK_ACCESS_TOKEN=
RESEARCH_INSTAGRAM_ACCESS_TOKEN=
RESEARCH_INSTAGRAM_ACCOUNT_ID=
# Host binding for deployments behind an existing reverse proxy.
API_BIND=127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Orbit <no-reply@example.com>
SMTP_STARTTLS=true
MAX_REQUEST_BYTES=2000000
MAX_FILE_BYTES=25000000
FILE_STORAGE_DIR=./data/files
# Set at frontend build time when public authentication is enabled.
VITE_AUTH_REQUIRED=true

# Production Docker/PostgreSQL
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-this-long-random-password
